    },
    {
      "number": 5,
      "coveredCharacters": 1326,
      "segments": [
        {
          "type": "furniture",
          "text": "ADVANCED DIAGNOSTICS & MANAGEMENT OF THYROID NODULES BA Medicale Medical Series | www.BAMedicale.com",
          "size": 7.5,
