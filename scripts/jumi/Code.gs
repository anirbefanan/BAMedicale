  const folder=jumiEvidenceFolder_(row['Event ID']),ext={'image/jpeg':'jpg','image/png':'png','application/pdf':'pdf'}[mime],stamp=Utilities.formatDate(new Date(),JUMI_TZ,'yyyyMMdd_HHmmss'),name=stamp+'_'+String(row['Registrant ID']).replace(/[^a-zA-Z0-9_-]/g,'-')+'.'+ext,file=folder.createFile(Utilities.newBlob(bytes,mime,name));
  const before={...row},next={...row,'Proof File ID':file.getId(),'Updated At':jumiNow_(),'Updated By':admin.email};delete next._row;jumiUpdateRow_(sheet,row._row,JUMI_REGISTRANT_HEADERS,next);jumiAudit_(ss,admin,'UPLOAD_PAYMENT_PROOF','registrant',row['Registrant ID'],{'Proof File ID':before['Proof File ID']||''},{'Proof File ID':file.getId()});return{saved:true,reference:'stored'};
}
function jumiGetProofUrl_(data){const ss=jumiSs_(),row=jumiObjects_(jumiTab_(ss,'registrants'),JUMI_REGISTRANT_HEADERS).find(item=>String(item['Registrant ID'])===String(data.registrantId));jumiAssert_(row&&row['Proof File ID'],'Payment proof not found.');return{url:DriveApp.getFileById(String(row['Proof File ID'])).getUrl()};}
