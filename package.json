{
  "scripts": {
    "admin": "node admin/server.js",
    "admin:check": "node admin/server.js --check",
    "articles:build": "node scripts/build-articles.js",
    "articles:check": "node scripts/build-articles.js --check",
    "content:build": "node scripts/build-articles.js",
    "content:check": "node scripts/build-articles.js --check && node --test scripts/content-registry.test.js scripts/article-layout.test.js scripts/presentation.test.js scripts/ebook.test.js && node scripts/attendance/build.js --check",
    "seminars:build": "node scripts/build-articles.js",
    "seminars:check": "node scripts/build-articles.js --check",
    "traffic:bootstrap": "node scripts/fetch-ga4-traffic.js --bootstrap",
    "traffic:validate": "node scripts/fetch-ga4-traffic.js --validate data/traffic-summary.json --allow-pending",
    "traffic:test": "node --test scripts/traffic-data.test.js scripts/traffic-page.test.js",
    "attendance:build": "node scripts/attendance/build.js",
    "attendance:check": "node scripts/attendance/build.js --check && node --test scripts/attendance/*.test.js",
    "quiz:build": "node scripts/quiz/build.js",
    "quiz:check": "node scripts/quiz/build.js --check && node --test scripts/quiz/*.test.js",
    "jumi:build": "node scripts/jumi/build.js",
    "jumi:check": "node scripts/jumi/build.js --check && node --check jumi/app.js && node --check scripts/jumi/backend.js && node --test scripts/jumi/*.test.js"
  },
  "private": true,
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  }
}
